# Copy to your host's environment settings (never commit real values).

# Set only in the production environment. The build fails if site.config.json lacks
# brand_name, site_url, operator_name or contact_email.
SITE_ENV=production

# Inquiry delivery: configure at least one. An inquiry counts as received only if one succeeds.
# 1) Email via Resend (https://resend.com). Without a verified domain, Resend only sends
#    from onboarding@resend.dev to your own account address.
RESEND_API_KEY=
INQUIRY_TO=you@example.com
INQUIRY_FROM=Website inquiries <onboarding@resend.dev>

# 2) Optional second copy: JSON POST to a webhook (spreadsheet, automation tool, etc.).
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# 3) Self-hosted Node server or local development only (serverless hosts have no durable disk).
INQUIRY_FILE_STORE=.data/inquiries.jsonl

# Optional: Cloudflare Turnstile. Put the public site key in site.config.json (turnstile_site_key).
TURNSTILE_SECRET_KEY=
