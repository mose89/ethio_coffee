# Copy the values you need into your host's environment settings (or .env.local for development).
# Never commit real values.

# --- Required in production -------------------------------------------------
SITE_ENV=production                 # omit locally: builds a noindex preview instead
PAYLOAD_SECRET=                     # long random string, e.g. `openssl rand -hex 32`
DATABASE_URL=file:/data/cms.db      # SQLite file on a persistent volume (default locally: data/cms.db)
MEDIA_DIR=/data/media               # uploaded images, on the same persistent volume

# --- Email (optional but recommended) ----------------------------------------
# Resend (https://resend.com). Without a verified domain, Resend only sends from
# onboarding@resend.dev to your own Resend account address.
RESEND_API_KEY=
INQUIRY_TO=you@example.com                                # new-inquiry notifications
INQUIRY_FROM=Website inquiries <onboarding@resend.dev>
CMS_EMAIL_FROM=                                           # enables CMS password-reset emails, e.g. cms@your-domain.com

# --- Other inquiry destinations (optional) -----------------------------------
INQUIRY_STORE_CMS=true              # store inquiries in the CMS (default)
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=
INQUIRY_FILE_STORE=

# --- Spam protection (optional) ----------------------------------------------
TURNSTILE_SECRET_KEY=               # also set turnstile_site_key in site.config.json

# --- One-off: create the first CMS admin (npm run create-admin) --------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
